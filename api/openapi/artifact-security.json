  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Status": {
        "type": "string",
        "enum": [
          "unscanned",
          "pending",
          "scanning",
          "passed",
          "warning",
          "blocked",
          "failed",
          "cancelled"
        ]
      },
      "Finding": {
        "type": "object",
        "required": [
          "scanner",
          "version",
          "rule",
          "severity"
        ],
        "properties": {
          "scanner": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        }
      },
      "File": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "size",
          "status",
          "findings",
          "checks",
          "reused"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "findings": {
            "type": "array",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/Finding"
            }
          },
          "checks": {
            "type": "array",
            "nullable": true,
            "items": {
              "type": "string"
            }
          },
          "error": {
            "type": "string"
          },
          "reused": {
            "type": "boolean"
          },
          "ruleset": {
            "type": "string"
          },
          "file_type": {
            "type": "string",
            "description": "zip/pickle are identified by the static scanner. Suffix-based categories end with -by-name; old or incomplete reports may omit this field."
          },
          "checked_at": {
            "type": "string",
            "format": "date-time",
            "description": "Start of the original file check. Reused results retain their original check time."
          },
          "recommended_action": {
            "type": "string",
            "enum": [
              "quarantine_and_replace",
              "manual_review",
              "distribute_by_policy",
              "repair_and_rescan"
            ],
            "description": "Disposition advice; actual download permission is evaluated by project policy."
          }
        }
      },
      "Report": {
        "type": "object",
        "required": [
          "repo",
          "revision",
          "status",
          "files",
          "updated_at",
          "attempt",
          "force"
        ],
        "properties": {
          "repo": {
            "type": "string"
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "files": {
            "type": "array",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/File"
            }
          },
          "error": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "attempt": {
            "type": "integer",
            "format": "int64"
          },
          "ruleset": {
            "type": "string"
          },
          "force": {
            "type": "boolean"
          }
        }
      },
      "Policy": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "block_severity",
          "on_pending",
          "on_failure"
        ],
        "properties": {
          "block_severity": {
            "type": "string",
            "enum": [
              "medium",
              "high"
            ]
          },
          "on_pending": {
            "type": "string",
            "enum": [
              "block",
              "allow"
            ]
          },
          "on_failure": {
            "type": "string",
            "enum": [
              "block",
              "allow"
            ]
          }
        }
      },
      "AuditEvent": {
        "type": "object",
        "required": [
          "id",
          "repo",
          "revision",
          "attempt",
          "actor",
          "action",
          "detail",
          "at"
        ],
        "properties": {
          "repo": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "attempt": {
            "type": "integer",
            "format": "int64"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Audit": {
        "type": "object",
        "required": [
          "events"
        ],
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditEvent"
            }
          }
        }
      },
      "RescanInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "force": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
