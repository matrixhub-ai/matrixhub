{
  "openapi": "3.0.3",
  "info": {
    "title": "MatrixHub artifact security API",
    "version": "v1alpha1",
    "description": "Opt-in API. Existing repository permissions apply to reads and task operations; changing policy additionally requires project management. API Bearer tokens and existing MatrixHub web sessions are supported. Browser session writes require matching Origin. Public repository reads may be anonymous. Scan status describes the recorded static checks; historical passed reports remain available while the scanner is offline. New incomplete scans fail closed under the default policy."
  },
  "paths": {
    "/api/security/v1alpha1/models/{namespace}/{repo}/report": {
      "get": {
        "operationId": "security_get_report",
        "summary": "Read the report bound to the requested revision",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "repo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "revision",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Commit SHA or Git ref; omitted uses the default branch. The response always carries a resolved commit SHA."
          }
        ],
        "responses": {
          "200": {
            "description": "Read the report bound to the requested revision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Report"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "example": "authentication required"
              }
            }
          },
          "403": {
            "description": "Permission denied or browser write violates same-origin requirement",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "example": "authentication required"
              }
            }
          },
          "404": {
            "description": "Repository or revision unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Task changed or action conflicts with current status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Authorization, database or report unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
