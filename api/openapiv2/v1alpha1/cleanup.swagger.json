{
  "swagger": "2.0",
  "info": {
    "title": "v1alpha1/cleanup.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "Cleanup"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/v1alpha1/cleanup/execute": {
      "post": {
        "summary": "Execute cleanup; dry_run previews without deleting",
        "operationId": "Cleanup_ExecuteCleanup",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1alpha1CleanupResult"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1alpha1ExecuteCleanupRequest"
            }
          }
        ],
        "tags": [
          "Cleanup"
        ]
      }
    },
    "/api/v1alpha1/cleanup/stats": {
      "get": {
        "summary": "Get storage statistics",
        "operationId": "Cleanup_GetStorageStats",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1alpha1StorageStats"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "Cleanup"
        ]
      }
    }
  },
  "definitions": {
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1alpha1CleanupResult": {
      "type": "object",
      "properties": {
        "spaceReclaimedBytes": {
          "type": "string",
          "format": "int64"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "orphanedRepos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gc": {
          "$ref": "#/definitions/v1alpha1GCResult"
        }
      }
    },
    "v1alpha1ExecuteCleanupRequest": {
      "type": "object",
      "properties": {
        "cleanOrphanedRepos": {
          "type": "boolean"
        },
        "cleanOrphanedLfs": {
          "type": "boolean"
        },
        "dryRun": {
          "type": "boolean",
          "title": "true = preview only, no actual deletion"
        },
        "grace": {
          "type": "string",
          "title": "unset = configured gcGrace; \"0s\" disables the grace window"
        },
        "maxDeletes": {
          "type": "integer",
          "format": "int32",
          "title": "max shard+xorb deletions per sweep, 0 = unlimited; ignored by dry runs"
        },
        "budget": {
          "type": "string",
          "title": "wall-clock cap on the sweep, unset/0 = unlimited; ignored by dry runs"
        }
      }
    },
    "v1alpha1GCResult": {
      "type": "object",
      "properties": {
        "dryRun": {
          "type": "boolean"
        },
        "repositories": {
          "type": "integer",
          "format": "int32",
          "title": "repositories scanned, GC failures included"
        },
        "deletedGitObjects": {
          "type": "integer",
          "format": "int32"
        },
        "deletedGitBytes": {
          "type": "string",
          "format": "int64",
          "title": "uncompressed payload of the deleted Git objects"
        },
        "gitReclaimedBytes": {
          "type": "string",
          "format": "int64",
          "title": "shrink of Git object storage; 0 in a dry run, which repacks nothing"
        },
        "failed": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "title": "repository path -\u003e Git GC error; its LFS pointers stay live"
        },
        "liveObjects": {
          "type": "integer",
          "format": "int32"
        },
        "unlinked": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "sorted sha256 hex; dry run: what would be unlinked"
        },
        "pruneSkippedInGrace": {
          "type": "integer",
          "format": "int32"
        },
        "sweptShards": {
          "type": "integer",
          "format": "int32"
        },
        "sweptXorbs": {
          "type": "integer",
          "format": "int32"
        },
        "xetReclaimedBytes": {
          "type": "string",
          "format": "int64",
          "title": "shard and xorb bytes the sweep reclaimed"
        },
        "sweepSkippedInGrace": {
          "type": "integer",
          "format": "int32"
        },
        "dangling": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "OIDs whose data is missing; reported, never deleted"
        },
        "unreadableShards": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "treated live; no xorb deleted that pass"
        },
        "sweepDone": {
          "type": "boolean",
          "title": "null: no sweep result because the prune or the sweep failed; false: a bounded sweep left data; true: finished",
          "x-nullable": true
        },
        "remainingShards": {
          "type": "integer",
          "format": "int32"
        },
        "remainingXorbs": {
          "type": "integer",
          "format": "int32"
        }
      },
      "description": "One run of Git GC, LFS prune and the sweep of already-unlinked data; a dry run's sweep estimates that data, not this run's still-linked candidates."
    },
    "v1alpha1GitStorageUsage": {
      "type": "object",
      "properties": {
        "objects": {
          "$ref": "#/definitions/v1alpha1StorageObjectUsage",
          "title": "loose and packed Git objects"
        },
        "other": {
          "$ref": "#/definitions/v1alpha1StorageObjectUsage",
          "title": "everything else in the repository, such as refs and config"
        }
      },
      "description": "Every repository under the repositories root; unreachable objects included, LFS content excluded."
    },
    "v1alpha1StorageObjectUsage": {
      "type": "object",
      "properties": {
        "count": {
          "type": "string",
          "format": "int64"
        },
        "bytes": {
          "type": "string",
          "format": "int64"
        }
      }
    },
    "v1alpha1StorageStats": {
      "type": "object",
      "properties": {
        "totalSizeBytes": {
          "type": "string",
          "format": "int64",
          "title": "every Git and xet category summed"
        },
        "git": {
          "$ref": "#/definitions/v1alpha1GitStorageUsage"
        },
        "xet": {
          "$ref": "#/definitions/v1alpha1XetStorageUsage"
        }
      },
      "description": "Storage by kind; not an atomic snapshot."
    },
    "v1alpha1XetStorageUsage": {
      "type": "object",
      "properties": {
        "xorbs": {
          "$ref": "#/definitions/v1alpha1StorageObjectUsage"
        },
        "shards": {
          "$ref": "#/definitions/v1alpha1StorageObjectUsage"
        },
        "fileIndex": {
          "$ref": "#/definitions/v1alpha1StorageObjectUsage"
        },
        "chunkIndex": {
          "$ref": "#/definitions/v1alpha1StorageObjectUsage"
        },
        "sha256Index": {
          "$ref": "#/definitions/v1alpha1StorageObjectUsage"
        }
      }
    }
  }
}
