            "name": "project",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "name",
            "description": "Name of the model. As on Hugging Face, it may start with '_'.",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "revision",
            "description": "Branch, tag or commit. Empty means the default branch. It resolves, and\nis rejected, as the revision of CacheModelRequest.",
