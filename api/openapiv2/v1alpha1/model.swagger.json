        },
        "state": {
          "$ref": "#/definitions/v1alpha1CacheFileState"
        },
        "downloadedBytes": {
          "type": "string",
          "format": "int64"
        },
        "error": {
          "type": "string"
        }
      }
    },
    "v1alpha1ModelCacheStatus": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "requestedRevision": {
          "type": "string"
        },
        "revision": {
          "type": "string",
          "description": "The branch, tag or commit that was listed: requested_revision, or the name\nof the default branch when none was requested. A dry run leaves it empty\nwhen the registry does not name its default branch. It and commit are\nempty for a proxy model that has not synced yet: none of its files are\nknown."
        },
        "commit": {
          "type": "string"
        },
        "state": {
          "$ref": "#/definitions/v1alpha1CacheState",
          "description": "How much of the selected files is cached; see CacheState."
        },
        "totals": {
          "$ref": "#/definitions/v1alpha1ModelCacheTotals"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1alpha1ModelCacheFile"
          }
        },
        "task": {
          "$ref": "#/definitions/v1alpha1ModelCacheTask",
          "description": "The latest pull that the server knows of: of the requested selection for\nCacheModel; for GetModelCache, of files of the revision only, a running\none first. Unset when there is none, for example when no pull was\nstarted, the last one finished more than an hour ago, or the server\nrestarted since. A failed pull whose failed files were stored since is\nnot reported."
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "v1alpha1ModelCacheTask": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Opaque and unique per run: retrying a failed pull starts a new run."
        },
        "state": {
          "$ref": "#/definitions/v1alpha1CacheTaskState"
        },
        "startedAt": {
          "type": "string"
        },
        "finishedAt": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      },
      "description": "One run of a pull."
    },
    "v1alpha1ModelCacheTotals": {
      "type": "object",
      "properties": {
        "files": {
          "type": "string",
          "format": "int64"
        },
        "bytes": {
          "type": "string",
          "format": "int64",
          "description": "Total size of the files."
        },
        "cachedFiles": {
          "type": "string",
          "format": "int64"
        },
        "cachedBytes": {
          "type": "string",
          "format": "int64"
        },
        "downloadingFiles": {
          "type": "string",
          "format": "int64"
        },
        "downloadingBytes": {
          "type": "string",
          "format": "int64",
          "description": "Bytes downloaded so far of the files in DOWNLOADING state, not their\nsize."
        },
        "queuedFiles": {
          "type": "string",
          "format": "int64"
        },
        "missingFiles": {
          "type": "string",
          "format": "int64"
        },
        "failedFiles": {
          "type": "string",
          "format": "int64"
        }
      }
    },
    "v1alpha1Pagination": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "format": "int32",
          "description": "Total is the total number of referents."
        },
        "page": {
          "type": "integer",
          "format": "int32",
          "description": "Page is current page."
        },
        "pageSize": {
          "type": "integer",
          "format": "int32",
          "description": "PageSize is the data number shown per page."
        },
        "pages": {
          "type": "integer",
          "format": "int32",
          "description": "Pages is the number of pages."
        }
      },
      "description": "Pagination is for data paging."
    },
    "v1alpha1Revision": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "v1alpha1Revisions": {
      "type": "object",
      "properties": {
        "branches": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1alpha1Revision"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1alpha1Revision"
          }
        }
      }
    },
    "v1alpha1UpdateModelSettingResponse": {
      "type": "object"
    }
  }
}
