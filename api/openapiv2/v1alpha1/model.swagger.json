  "definitions": {
    "ModelsCacheModelBody": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "description": "Branch, tag or commit. Empty means the default branch. A name resolves as\ngit, and MatrixHub when hf download asks it, resolve it: a commit id\nfirst, then a tag before a branch of the same name. MatrixHub mirrors only\nbranches and tags, so other refs, such as refs/pr/1, are rejected, and a\nname that upstream knows only as such a ref, as huggingface.co knows pr/1,\nis not found. Revision expressions such as main~1, which upstream does not\nresolve, and names that contain '@' are rejected too."
        },
        "allowPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Narrow the cached files; without patterns every file of the revision is\ncached. Patterns follow huggingface_hub fnmatch semantics: '*' and '?'\nalso match '/', a trailing '/' selects a whole directory, and '\\' counts\nas '/'. A list holds at most 16 patterns, and a pattern at most 256\ncharacters and 16 wildcards ('*', '?' and classes)."
        },
        "ignorePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Files that match an ignore pattern are not cached, even when they match\nan allow pattern. Same syntax and limits as allow_patterns."
        },
        "dryRun": {
          "type": "boolean",
          "description": "Only report what a pull would do: the upstream files of the revision and\nwhich of them are cached. A dry run creates nothing and downloads\nnothing."
        }
      }
    },
