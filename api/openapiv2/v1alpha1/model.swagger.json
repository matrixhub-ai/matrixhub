            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "Models"
        ]
      },
      "post": {
        "summary": "CacheModel pulls a revision of a proxy-project model from upstream into\nMatrixHub storage on the server. The model may not exist locally yet.\nWith dry_run it only lists the upstream files and reports what is already\ncached: it never syncs, creates the model, or starts downloads.",
