    "v1alpha1CacheFileState": {
      "type": "string",
      "enum": [
        "CACHE_FILE_STATE_UNSPECIFIED",
        "CACHE_FILE_STATE_CACHED",
        "CACHE_FILE_STATE_DOWNLOADING",
        "CACHE_FILE_STATE_QUEUED",
        "CACHE_FILE_STATE_MISSING",
        "CACHE_FILE_STATE_FAILED"
      ],
      "default": "CACHE_FILE_STATE_UNSPECIFIED",
      "description": " - CACHE_FILE_STATE_QUEUED: Part of a running cache task, not started yet, or waiting for its next\nattempt; error then tells why the last attempt failed."
    },
    "v1alpha1CacheState": {
      "type": "string",
      "enum": [
        "CACHE_STATE_UNSPECIFIED",
        "CACHE_STATE_MISSING",
        "CACHE_STATE_PARTIAL",
        "CACHE_STATE_CACHED"
      ],
      "default": "CACHE_STATE_UNSPECIFIED",
      "description": "How much of the selected files is in MatrixHub storage. Files stored in git\nare present once the commit is synced, so LFS objects decide between\nMISSING and PARTIAL.\n\n - CACHE_STATE_MISSING: No LFS object of the selection is cached.\n - CACHE_STATE_CACHED: Every selected file is cached."
    },
    "v1alpha1CacheTaskState": {
      "type": "string",
      "enum": [
        "CACHE_TASK_STATE_UNSPECIFIED",
        "CACHE_TASK_STATE_RUNNING",
        "CACHE_TASK_STATE_SUCCEEDED",
        "CACHE_TASK_STATE_FAILED"
      ],
      "default": "CACHE_TASK_STATE_UNSPECIFIED"
    },
